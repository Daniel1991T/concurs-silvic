# Copiază fișierul în .env.local și completează valorile. .env.local nu intră în git.

# Adresa bazei de date. Din Neon: Dashboard → proiectul → Connect → „Connection string” (cu ?sslmode=require).
DATABASE_URL="postgresql://neondb_owner:npg_rFVlKOvAG9E0@ep-wild-cell-b9qnenp3-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Cheia cu care se semnează sesiunile de login. Generează una cu:  npx @better-auth/cli secret
# sau orice șir aleator de minimum 32 de caractere.
BETTER_AUTH_SECRET="schimba-ma-cu-un-sir-aleator-lung"

# Adresa aplicației. Local: http://localhost:3000 ; pe Vercel: adresa site-ului.
BETTER_AUTH_URL="http://localhost:3000"

# Pune "true" după ce ți-ai făcut contul, ca să nu mai poată crea nimeni altul.
DISABLE_SIGNUP="false"
